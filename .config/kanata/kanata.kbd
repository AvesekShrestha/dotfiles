(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold yes
)
(defvar
  tap-time 170
  hold-time 170
)
(defsrc
  q a s d f g h j k l ;
  w e r t y u o p
  n c v
  i
  , . ' / \
  spc
  caps
  lsft rsft
)
(deflayer base
  q    a    s    d    f    g    h    j    k    l    ;
  w    e    r    t    y    u    o    p
  n    c    v
  i
  ,    .    '    /    \
  (tap-hold $tap-time $hold-time spc (layer-while-held mod))
  (tap-hold $tap-time $hold-time esc (multi lmet lalt lsft lctl))
  (layer-while-held shift-layer)
  (layer-while-held shift-layer)
)
(deflayer mod
  q
  (tap-hold $tap-time $hold-time a lmet)
  (tap-hold $tap-time $hold-time s lalt)
  (tap-hold $tap-time $hold-time d lsft)
  (tap-hold $tap-time $hold-time f lctl)
  g
  h
  (tap-hold $tap-time $hold-time j rctl)
  (tap-hold $tap-time $hold-time k rsft)
  (tap-hold $tap-time $hold-time l ralt)
  (tap-hold $tap-time $hold-time ; rmet)
  w    e    r    t    y    u    o    p
  n    c    v
  i
  ,    .    '    /    \
  _
  bspc
  _
  _
)
(deflayer shift-layer
  grv  S-1  S-[  S-]  S-5  S-8  0    left down rght S-;
  S-9  S-0  S-4  S-2  S-grv    S--  =    S-=
  S-3  S-7  S-6
  up
  S-,  S-.  S-'  S-/  S-\
  _
  caps
  _
  _
)
